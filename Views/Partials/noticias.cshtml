@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>

<section data-w-id="17b55e63-d9ac-08eb-d30c-7863d68685e1" style="opacity:0" class="section_noticias">
    <div class="w-layout-blockcontainer container-14 w-container">
        <div class="div-block-32">
            <div class="div_title">
                <div class="line_separator"></div>
                <h4 class="heading-6">@Model.Titulo</h4>
            </div>
        </div>
    </div>

    @if (Model.Noticias != null && Model.Noticias.Any())
    {
        <div class="w-layout-blockcontainer container-13 w-container">
            <div data-delay="8000" data-animation="slide" class="slider-2 w-slider" data-autoplay="true" data-easing="ease-out" data-hide-arrows="true" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="2000" data-infinite="false">
                <div class="mask w-slider-mask">
                    @foreach (var item in Model.Noticias)
                    {
                        var itemContent = item.Content;
                        var image = itemContent.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("image");
                        var title = itemContent.Value<string>("title");
                        var desc = itemContent.Value<string>("description");

                        <div class="slide w-slide">
                            <div class="noticia_card">
                                <div class="div_image_noticia" style="background-image: url('@image.Url()');"></div>
                                <div class="div-block-34">
                                    <h1 class="heading-7">@title</h1>
                                    <p class="noticia-text">@Html.Raw(desc)</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="left-arrow-2 w-slider-arrow-left">
                    <div class="icon-4 w-icon-slider-left"></div>
                </div>
                <div class="right-arrow w-slider-arrow-right">
                    <div class="icon-4 w-icon-slider-right"></div>
                </div>
                <div class="slide-nav-2 w-slider-nav w-round w-num"></div>
            </div>
        </div>
    }
</section>
