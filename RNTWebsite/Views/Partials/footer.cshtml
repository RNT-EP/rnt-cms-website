  @inherits UmbracoViewPage

  @{
    var siteSettings = Model.GetSiteSettings();
    if (siteSettings is null) return;
   }
  
  <section class="section_footer">
    <div data-w-id="97713791-0e66-e396-c6f1-d8e408d4c4f4" class="w-layout-blockcontainer container_footer w-container">
      <div class="div_footer">
        <div class="div_image_footer"><img src="~/images/LOGO_Inferiro-4.svg" loading="lazy" alt=""></div>
        <div class="div_footer_flex">
              @await Html.GetBlockGridHtmlAsync(siteSettings, "footerContent")
        </div>
      </div>
      <div class="div_end_footer">
        <a href="#" class="footer_secondary_link">&copy; @Umbraco.GetDictionaryValue("Declaração de Direitos Autorais") @DateTime.Now.Year</a>
        <a href="#" class="footer_secondary_link">Política de Privacidade | Termos e Condições</a>
      </div>
    </div>
  </section>