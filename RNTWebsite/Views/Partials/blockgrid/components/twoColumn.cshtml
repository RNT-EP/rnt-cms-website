@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>

@{
    var leftArea = Model.Areas.FirstOrDefault(a => a.Alias == "left");  // Obtém a área da esquerda
    var rightArea = Model.Areas.FirstOrDefault(a => a.Alias == "right"); // Obtém a área da direita
}

<section data-w-id="e2a2141a-0912-70f3-daf0-01c0007f7a05" style="opacity:0" class="section_message">
    <div class="w-layout-blockcontainer container_message inicio w-container">
        <div class="div-block-15 inicio">
            <div>
                @await Html.GetBlockGridItemAreaHtmlAsync(leftArea)
                <div class="div-block-22">
                    @await Html.GetBlockGridItemAreaHtmlAsync(rightArea)
                </div>
            </div>
        </div>
    </div>
</section>