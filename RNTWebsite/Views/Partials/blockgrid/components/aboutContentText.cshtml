@inherits UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ContentModels.AboutContentText>>


<div class="div_title">
        <div class="line_separator"></div>
        <h4 class="heading-6">@Model.Content.Title</h4>
</div>
<p class="sobre_paragraph">A Rede Nacional de Eletricidade (RNE) de Angola desempenha um papel estratégico no desenvolvimento económico e social do país, conectando centros de geração, transmissão e distribuição de energia elétrica a consumidores em todo o território nacional. Esta infraestrutura é essencial para impulsionar a industrialização, melhorar o acesso à eletricidade e promover a qualidade de vida da população.</p>
